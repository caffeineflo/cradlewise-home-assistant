# Required bridge settings
CRADLEWISE_CRADLE_ID=00000000-0000-4000-8000-000000000000
CRADLEWISE_CRIB_IP=192.0.2.10
CRADLEWISE_BIND_ADDRESS=192.0.2.20

# Required authentication. Generate each secret independently, for example
# with `openssl rand -hex 32`.
CRADLEWISE_STATUS_TOKEN=
CRADLEWISE_RTSP_PUBLISH_USER=cradlewise-publisher
CRADLEWISE_RTSP_PUBLISH_PASSWORD=
CRADLEWISE_RTSP_READ_USER=cradlewise-reader
CRADLEWISE_RTSP_READ_PASSWORD=

# Optional cloud fallback. Local MQTT supplies the normal shadow state.
# Use direct values here, or leave them empty and use the corresponding
# file-backed variables below. A non-empty direct value and its _FILE variable
# cannot both be configured.
CRADLEWISE_EMAIL=
CRADLEWISE_PASSWORD=
# CRADLEWISE_EMAIL_FILE=/run/secrets/cradlewise_email
# CRADLEWISE_PASSWORD_FILE=/run/secrets/cradlewise_password
CRADLEWISE_STATE_POLL_INTERVAL=30
